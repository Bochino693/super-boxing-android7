; PLUGIN USB DO SUPER BOXING (Arduino + webcam) — formato do Godot 3.
;
; O .aar ao lado é o plugin compilado. O GERAR_APK tenta recompilá-lo a
; partir de tools/android_usb_plugin; se não conseguir, este que já está
; aqui entra no APK.

[config]

name="PunchUsbSerial"
binary_type="local"
binary="PunchUsbSerial-release.aar"

[dependencies]

remote=["com.github.mik3y:usb-serial-for-android:3.11.0", "com.github.jiangdongguo.AndroidUSBCamera:libausbc:3.2.7", "com.github.jiangdongguo.AndroidUSBCamera:libuvc:3.2.7"]
custom_maven_repos=["https://jitpack.io"]
